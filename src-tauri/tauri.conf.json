{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DocSniffer",
  "version": "0.2.0",
  "identifier": "cn.helilab.docsniffer",
  "mainBinaryName": "docsniffer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "features": ["tauri-app"]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "externalBin": [],
    "copyright": "© 2026 Security Dept",
    "category": "Utility",
    "shortDescription": "DocSniffer Portable Scanner",
    "longDescription": "Enterprise-grade file content sniffing and sensitive data discovery tool.",
    "windows": {
      "webviewInstallMode": { "type": "skip" },
      "wix": null,
      "nsis": null
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": { "depends": [] },
      "appimage": { "bundleMediaFramework": false }
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DocSniffer",
        "width": 1100,
        "height": 720,
        "minWidth": 480,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'none'",
      "devCsp": null
    }
  }
}
